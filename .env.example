# FUTURE CLOUD INTEGRATION ONLY. Native V6 prototype does NOT read these variables.
# Never put Supabase secret/service-role credentials in this file or client code.
# The publishable key is designed for public clients, but RLS MUST be enabled and tested.
ORBIT_SUPABASE_URL=
ORBIT_SUPABASE_PUBLISHABLE_KEY=
# Your HTTPS domain after Vercel deployment, or http://localhost:4173 for local development.
ORBIT_SITE_URL=http://localhost:4173
# Optional: do not store personal data before Auth + RLS are active.
